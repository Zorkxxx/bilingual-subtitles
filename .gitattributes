# Preserve the validated skill files byte for byte across checkouts.
/SKILL.md -text
/version.json -text
/agents/** -text
/references/** -text
/scripts/** -text

# Repository-facing documentation uses UTF-8 with LF line endings.
/README.md text eol=lf
/CHANGELOG.md text eol=lf
/RELEASE_NOTES.md text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf
